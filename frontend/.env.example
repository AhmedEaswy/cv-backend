# Laravel API base URL for the Nuxt app.
# With Laragon + scripts/laragon/cv.test.conf, use https://cv.test.
# Without the proxy, use http://localhost:8000 (php artisan serve).
NUXT_PUBLIC_LARAVEL_URL=https://cv.test
NUXT_PUBLIC_APP_NAME=CV
NUXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/us/app/cv-resume-builder/id6744250877
NUXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.cv.creator
