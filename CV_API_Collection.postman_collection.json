	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"const access_token = pm.environment.get('auth_token');",
					"pm.request.headers.add({",
					"    key: 'Authorization',",
					"    value: access_token ? `Bearer ${access_token}` : null",
					"});"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"let jsonData = pm.response.json();",
					"let token = jsonData?.result?.token || null;",
					"if (token) {",
					"    pm.environment.set('auth_token', token);",
					"    console.log('Token set in environment.');",
					"}",
					"let id = jsonData?.result?.id || null;",
					"if (id && pm.info.requestName.startsWith('POST Create CV')) {",
					"    pm.environment.set('cv_id', id);",
					"}",
					"if (id && pm.info.requestName.startsWith('POST Create Cover Letter')) {",
					"    pm.environment.set('cover_letter_id', id);",
					"}"
				]
			}
		}
	],
