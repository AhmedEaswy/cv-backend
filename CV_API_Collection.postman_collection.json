		{
			"name": "3. CVs",
			"item": [
				{
					"name": "GET List My CVs",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/v1/cvs?language=en",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "cvs"],
							"query": [{ "key": "language", "value": "en", "description": "Optional filter" }]
						},
						"description": "Get authenticated user's CVs with optional language filter."
					},
					"response": []
				},
				{
					"name": "GET Get CV by ID",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/v1/cvs/{{cv_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "cvs", "{{cv_id}}"]
						},
						"description": "Fetch a specific CV by ID."
					},
					"response": []
				},
				{
					"name": "POST Create CV",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"My Professional CV\",\n  \"language\": \"en\",\n  \"user_data\": {\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"jobTitle\": \"Senior Developer\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"+1-555-123-4567\",\n    \"summary\": \"Experienced developer with 5+ years.\",\n    \"skills\": [\n      { \"name\": \"PHP\" },\n      { \"name\": \"Laravel\" },\n      { \"name\": \"JavaScript\" }\n    ],\n    \"experiences\": [\n      {\n        \"position\": \"Senior Developer\",\n        \"company\": \"Tech Corp\",\n        \"from\": \"2021-01\",\n        \"current\": true\n      }\n    ]\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/cvs",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "cvs"]
						},
						"description": "Create a new CV. Auth optional (if authenticated, associates with user)."
					},
					"response": []
				},
				{
					"name": "PUT Update CV",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated CV Name\",\n  \"language\": \"en\",\n  \"user_data\": {\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe Updated\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/cvs/{{cv_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "cvs", "{{cv_id}}"]
						},
						"description": "Update a CV you own."
					},
					"response": []
				},
				{
					"name": "DELETE Delete CV",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": {
							"raw": "{{base_url}}/api/v1/cvs/{{cv_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "cvs", "{{cv_id}}"]
						},
						"description": "Soft delete a CV you own."
					},
					"response": []
				},
				{
					"name": "POST Print CV (From Profile)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"profile_id\": \"{{cv_id}}\",\n  \"template_id\": \"{{template_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/cvs/print",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "cvs", "print"]
						},
						"description": "Generate PDF from an existing profile using a template. Returns PDF URL."
					},
					"response": []
				},
				{
					"name": "POST Print CV (With Data - Unauthenticated)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"template_id\": \"{{template_id}}\",\n  \"name\": \"My CV\",\n  \"language\": \"en\",\n  \"user_data\": {\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"jobTitle\": \"Developer\",\n    \"email\": \"john@example.com\",\n    \"summary\": \"Brief summary.\",\n    \"skills\": [{ \"name\": \"PHP\" }]\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/cvs/print",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "cvs", "print"]
						},
						"description": "Generate PDF from CV data without saving a profile. Requires template_id."
					},
					"response": []
				}
			]
		},
